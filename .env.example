# Use dois valores aleatórios distintos, cada um com pelo menos 32 caracteres.
STUDIO_ACCESS_KEY=
STUDIO_SESSION_SECRET=

# Opcional para sugestões de pautas. Configure apenas no servidor.
OPENAI_API_KEY=
OPENAI_IDEAS_MODEL=gpt-5-mini

# Login individual em ambiente de teste
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use um projeto Supabase e uma conta Stripe de teste antes de ativar live.
STUDIO_BILLING_MODE=
STRIPE_SECRET_KEY=
STRIPE_STUDIO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
